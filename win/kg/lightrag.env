# ============================================================
#  LightRAG 서버 설정 템플릿 - 폐쇄망 / 번들 llama-server 백엔드
#  start-lightrag.bat이 처음 한 번 home\kg\work\.env로 복사한다. 이후 수정은 그 파일에서 한다.
#  출처: 폐쇄망지식그래프/07_scripts/lightrag.env (2026-09-22), tasks/pi-agent-kg-align 합의 7·12.
# ============================================================

### 서버 (로컬 바인딩만)
HOST=127.0.0.1
PORT=9621
WORKING_DIR=./rag_storage
INPUT_DIR=./inputs

### LLM - start-llama.bat kg (OpenAI 호환).
### start-lightrag.bat이 config.env의 LLAMA_PORT·EMBED_PORT·MODEL_ALIAS로 LLM_BINDING_HOST·
### EMBEDDING_BINDING_HOST·LLM_MODEL을 프로세스 환경에 넣는다. LightRAG는 .env를 override=False로
### 읽으므로 그 값이 이긴다 - 아래 세 값은 bat 없이 실행할 때의 기본값이다.
### BINDING_HOST를 비우면 라이브러리 기본값인 외부 OpenAI 주소로 나가려 한다 - 반드시 로컬로 고정.
LLM_BINDING=openai
LLM_MODEL=qwen3.8-27b
LLM_BINDING_HOST=http://127.0.0.1:8080/v1
LLM_BINDING_API_KEY=sk-no-key-required
TIMEOUT=600
LLM_TIMEOUT=600
TEMPERATURE=0.0
### 엔티티 추출은 구조화 출력만 필요하다 - 사고를 끄면 출력 예산을 답에만 쓴다.
### (번들이 고정한 Qwen3.8 원본 템플릿은 enable_thinking=false면 사고 지시를 넣지 않는다.)
OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

### 임베딩 - start-embedding.bat (bge-m3, 1024차원, 최대 8192토큰)
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_BINDING_HOST=http://127.0.0.1:8081/v1
EMBEDDING_BINDING_API_KEY=sk-no-key-required
EMBEDDING_BATCH_NUM=8
EMBEDDING_FUNC_MAX_ASYNC=4

### 리랭커 - start-rerank.bat (bge-reranker-v2-m3, 번들 llama-server의 /v1/rerank). tasks/pi-agent-reranker 합의.
### 질의 때 찾아낸 청크를 질의와 한 쌍씩 다시 채점해 순서를 바꾼다. 색인(문서 넣기)에는 쓰지 않는다.
### cohere 바인딩은 {model, query, documents, top_n}을 보내고 results[].relevance_score를 받는다 -
### llama-server의 응답과 같은 모양이다. start-lightrag.bat은 cohere와 null만 받는다.
### start-lightrag.bat이 config.env의 RERANK_PORT로 RERANK_BINDING_HOST를 프로세스 환경에 넣고,
### 띄우기 전에 실제 요청을 한 번 보내 답이 없으면 기동을 거부한다(LightRAG는 rerank가 실패해도
### 원래 순서로 조용히 계속하므로). 아래 HOST는 bat 없이 실행할 때의 기본값이다.
### 끄려면 RERANK_BINDING=null 과 RERANK_BY_DEFAULT=false 를 둔다(둘째를 빼면 질의마다 경고가 난다).
RERANK_BINDING=cohere
RERANK_MODEL=bge-reranker-v2-m3
RERANK_BINDING_HOST=http://127.0.0.1:8082/v1/rerank
RERANK_BINDING_API_KEY=sk-no-key-required
RERANK_BY_DEFAULT=true
### 문서 분할은 끈 채로 시작한다(초기 설정). CHUNK_SIZE 1200은 tiktoken으로 센 수이고 리랭커는
### 자기 토크나이저로 질의 + 청크 + 특수 토큰을 한 창(8192)에 넣는다 - 실제로 드는지는 리허설 11-24에서 본다.
### 한 문서라도 창을 넘으면 llama-server가 요청 전체를 HTTP 500으로 거절하고(Linux CPU 빌드 실측),
### LightRAG는 그 질의를 원래 순서로 답한다.
RERANK_ENABLE_CHUNKING=false
### 0.0 = 점수로 청크를 버리지 않고 순서만 바꾼다. llama-server의 점수는 0~1이 아닌 로짓이다
### (같은 b11010의 Linux CPU 빌드로 잰 예: 관련 문서 1.88, 무관한 문서 -9.76·-11.03). 0.6 같은
### 0~1 기준 임계값을 넣으면 쓸 청크까지 버려진다 - 올리려면 대상 PC에서 범위를 잰 뒤에 한다.
MIN_RERANK_SCORE=0.0
### start-rerank.bat은 슬롯 1개다. 30초(라이브러리 기본)는 1080 Ti에서 재지 않은 값이라 넉넉히 둔다 -
### 시간 초과도 조용한 원래 순서 대체다. 리허설에서 잰 지연으로 조정한다.
MAX_ASYNC_RERANK=1
RERANK_TIMEOUT=120

### 슬롯 예산 (합의 12). start-llama.bat kg는 기본 32768 / 4슬롯 = 슬롯당 8192.
### 요청 하나의 입력 + 출력 한도가 슬롯 창 안에 들어야 한다. LightRAG는 tiktoken으로 세고
### 모델은 Qwen 토크나이저로 세므로 두 수가 다르다 - 합계를 슬롯의 약 85% 이하로 둔다.
### 라이브러리 기본값(MAX_TOTAL_TOKENS 30000, SUMMARY_CONTEXT_SIZE 12000,
### MAX_EXTRACT_INPUT_TOKENS 20480)은 슬롯을 넘으므로 여기서 모두 낮춘다.
### config.env의 KG 슬롯은 8192 미만을 받지 않고, start-lightrag.bat이 떠 있는 서버를 확인한다.
### 품질 영향은 실측 전이다.
# 모델 출력 상한 (모든 요청 공통)
OPENAI_LLM_MAX_TOKENS=2500
# 엔티티·관계 추출 (LightRAG 1.5.7 operate.py 기준, codex R4 #2):
#  - 첫 추출 요청에는 상한이 없다 = 시스템 프롬프트(예시 포함) + 청크. 스테이징 PC에서 Qwen3.8
#    토크나이저로 잰 값: 시스템 약 1,550 + 청크(CHUNK_SIZE 1200 tiktoken) 약 900~1,500 = 약 2,500~3,100.
#    출력 2500을 더해도 약 5,600으로 슬롯 안이다. CHUNK_SIZE를 키우면 이 계산을 다시 한다.
#  - MAX_EXTRACT_INPUT_TOKENS는 후속 gleaning(첫 요청+응답+계속 지시) 입력의 상한이다. 넘으면
#    LightRAG가 gleaning을 건너뛴다(실패하지 않음). 입력 4000 + 출력 2500 = 6500.
MAX_EXTRACT_INPUT_TOKENS=4000
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
# 설명 요약: 입력 4000 + 출력 2500 = 6500
SUMMARY_CONTEXT_SIZE=4000
SUMMARY_MAX_TOKENS=1200
SUMMARY_LENGTH_RECOMMENDED=600
# 질의: 엔티티 1500 + 관계 1500 < 전체 4000, 출력 2500 = 6500
MAX_ENTITY_TOKENS=1500
MAX_RELATION_TOKENS=1500
MAX_TOTAL_TOKENS=4000

### 추출 동시성 (1080 Ti 3장 기준 보수적으로 - 폐쇄망지식그래프 원본값). KG_PARALLEL까지 올릴 수 있다.
MAX_ASYNC_LLM=2
MAX_PARALLEL_INSERT=1

### 저장소 (전부 로컬 파일 - 외부 DB 불필요)
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage

### 로그
LOG_LEVEL=INFO
VERBOSE=False
